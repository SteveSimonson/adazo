# Amazon Associates tracking ID (Store ID / Tracking ID)
VITE_AMAZON_ASSOCIATE_TAG=yourstore-20

# Amazon Creators API (server-side importer only; never expose as VITE_*)
AMAZON_CREATORS_CREDENTIAL_ID=your-credential-id
AMAZON_CREATORS_CREDENTIAL_SECRET=your-credential-secret
AMAZON_CREATORS_CREDENTIAL_VERSION=3.1
AMAZON_CREATORS_PARTNER_TAG=yourstore-20
AMAZON_CREATORS_MARKETPLACE=www.amazon.com
