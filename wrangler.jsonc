{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "adazo",
  "main": "worker/index.ts",
  "compatibility_date": "2026-07-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Worker runs for every request: SEO head injection, canonical
    // redirects, real 404s, and Cache-Control all happen in worker/index.ts.
    "run_worker_first": true
  },
  "workers_dev": true,
  // Zone routes (not custom_domain) so apex can keep existing A records.
  // www is also attached as a Workers custom domain via API.
  // Apex custom_domain fails while externally managed A records remain.
  "routes": [
    { "pattern": "adazo.com/*", "zone_name": "adazo.com" },
    { "pattern": "www.adazo.com/*", "zone_name": "adazo.com" }
  ],
  // Imagine ZDR video uploads + public /media/* delivery
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "adazo-media"
    }
  ],
  "observability": {
    "enabled": true
  }
}
