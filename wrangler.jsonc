{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "adazo",
  "main": "worker/index.ts",
  "compatibility_date": "2026-07-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "workers_dev": true,
  "routes": [
    { "pattern": "adazo.com", "custom_domain": true },
    { "pattern": "www.adazo.com", "custom_domain": true }
  ],
  "observability": {
    "enabled": true
  }
}
